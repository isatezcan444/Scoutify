{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://scoutify-kuv3.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://scoutify-kuv3.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://scoutify-kuv3.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://scoutify-kuv3.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
