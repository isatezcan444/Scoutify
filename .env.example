# ==============================================================================
# Scoutify - Environment Configuration Example
# Copy this file to .env and configure with your environment-specific credentials.
# ==============================================================================

# Project & Environment
PROJECT_NAME="Scoutify"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite or PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./scoutify.db"
# DATABASE_URL="postgresql+asyncpg://postgres:scoutifypassword123@localhost:5432/scoutify"

# Simulation Mode
# True  -> Safe mock outreach (no actual messages sent, marked as DEMO)
# False -> Live dispatching (via WhatsApp Cloud API or wa-gateway)
SIMULATION_MODE=True
SEED_DEMO_DATA=True

# Security
SECRET_KEY="replace-with-a-strong-random-secret-key-in-production"

# Local WhatsApp Gateway (Baileys / Simulator microservice)
WA_GATEWAY_URL="http://localhost:3001"
WA_GATEWAY_WEBHOOK_SECRET="replace-with-gateway-webhook-secret"
WA_GATEWAY_AUTH_TOKEN=""

# ==============================================================================
# WhatsApp Cloud API (Meta Graph API) Configuration
# ==============================================================================
# 1. Access Token: Permanent System User or User Access Token from Meta Business Suite
WHATSAPP_CLOUD_ACCESS_TOKEN=""

# 2. Phone Number ID: From WhatsApp -> API Setup in Meta Developer Dashboard
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""

# 3. WhatsApp Business Account ID (WABA ID)
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=""

# 4. Meta Graph API Version (e.g. v21.0, v22.0)
WHATSAPP_CLOUD_API_VERSION="v21.0"

# 5. Meta Graph API Base URL
WHATSAPP_CLOUD_GRAPH_API_BASE_URL="https://graph.facebook.com"

# 6. Webhook Verify Token: Must match the token configured in Meta App Dashboard
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN="scoutify-cloud-verify-token"

# 7. Meta App Secret: Used to cryptographically verify X-Hub-Signature-256 header (Optional but recommended)
WHATSAPP_CLOUD_APP_SECRET=""

# 8. Enable Cloud API Dispatching when SIMULATION_MODE=False
WHATSAPP_CLOUD_ENABLED=False

# Anti-Ban Policy Defaults
DEFAULT_MIN_DELAY_SECONDS=45
DEFAULT_MAX_DELAY_SECONDS=120
DEFAULT_TYPING_DELAY_SECONDS=4
DEFAULT_DAILY_LIMIT_PER_SESSION=50
DEFAULT_WORKING_HOURS_START="09:00"
DEFAULT_WORKING_HOURS_END="18:30"
